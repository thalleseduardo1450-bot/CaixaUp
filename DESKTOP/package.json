{
    "name": "caixaup-desktop",
    "productName": "CaixaUp",
    "version": "3.3.56",
    "description": "CaixaUp - frente de caixa. Dados no Supabase (nuvem), sem banco local.",
    "main": "main.js",
    "private": true,
    "scripts": {
        "icon": "node make-icon.js",
        "start": "electron .",
        "dist": "electron-builder --win nsis --x64",
        "dist:custom": "node ../gerar-instalador.cjs",
        "installer:custom": "powershell -NoProfile -ExecutionPolicy Bypass -File instalador/empacotar.ps1 -Versao %npm_package_version%",
        "dist:publish": "electron-builder --win nsis --x64 --publish always"
    },
    "devDependencies": {
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "br.com.caixaup.desktop",
        "productName": "CaixaUp",
        "artifactName": "CaixaUp-Setup-${version}.${ext}",
        "publish": [
            {
                "provider": "github",
                "owner": "thalleseduardo1450-bot",
                "repo": "CaixaUp",
                "releaseType": "release"
            }
        ],
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "files": [
            "main.js",
            "preload.js",
            "splash-preload.js",
            "splash.html",
            "build/icon.png",
            "build/icon.ico"
        ],
        "extraResources": [
            {
                "from": "../app/dist",
                "to": "web"
            }
        ],
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "include": "build/installer.nsh",
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "CaixaUp"
        }
    },
    "allowScripts": {
        "electron@44.3.0": true
    },
    "dependencies": {
        "electron-updater": "^6.8.9"
    }
}
