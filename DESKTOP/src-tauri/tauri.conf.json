{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaixaUp",
  "mainBinaryName": "CaixaUp",
  "version": "../package.json",
  "identifier": "br.com.caixaup.desktop",
  "build": {
    "frontendDist": "../../FRONTEND/dist",
    "beforeBuildCommand": "node -e \"require('fs').copyFileSync('splash.html','../FRONTEND/dist/splash.html')\""
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "CaixaUp",
    "icon": ["../build/icon.png", "../build/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "../build/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["PortugueseBR"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBOUU0MzY4REFDMzI5RkEKUldUNktjUGFhRU9leXFOd0RCdisxWWs2SG03MGN6czdSSWdOQWVad1lRNmRQdjBUNGkvWE5BOU0K",
      "endpoints": [
        "https://github.com/thalleseduardo1450-bot/CaixaUp/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
